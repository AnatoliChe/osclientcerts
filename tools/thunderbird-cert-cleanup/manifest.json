{
  "manifest_version": 3,
  "name": "OS Client Certs -- cert9.db cleanup",
  "version": "0.1.0",
  "description": "Removes stale, keyless duplicate copies of your OS Client Certs signing certificate that NSS sometimes caches into cert9.db from verified S/MIME signatures, which can silently break outgoing S/MIME signing. See README.md.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cert-cleanup@osclientcerts.dev",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/AnatoliChe/osclientcerts/trunk/fork-osclientcerts/tools/thunderbird-cert-cleanup/updates.json"
    }
  },
  "experiment_apis": {
    "certCleanup": {
      "schema": "experiments/certCleanup/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["certCleanup"]],
        "script": "experiments/certCleanup/implementation.js"
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["alarms", "notifications"]
}
