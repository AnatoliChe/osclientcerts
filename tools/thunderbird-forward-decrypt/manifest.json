{
  "manifest_version": 3,
  "name": "OS Client Certs -- decrypt & re-encrypt S/MIME forward",
  "version": "0.4.4",
  "description": "S/MIME forward with decrypted content and attachments. v0.4.4 (TEST) recognizes encrypted raw pkcs7-mime messages independently of the synthetic message/rfc822 wrapper returned by WebExtension APIs, while leaving ordinary and signed-only messages unchanged.",
  "browser_specific_settings": {
    "gecko": {
      "id": "forward-decrypt@osclientcerts.dev",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/AnatoliChe/osclientcerts/trunk/tools/thunderbird-forward-decrypt/updates.json"
    }
  },
  "permissions": [
    "compose",
    "messagesRead",
    "tabs",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html"
  },
  "experiment_apis": {
    "ForwardIntercept": {
      "schema": "api/ForwardIntercept/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["ForwardIntercept"]],
        "script": "api/ForwardIntercept/implementation.js",
        "events": ["startup"]
      }
    }
  }
}
